  "checks": {
    "followups_due_today_or_overdue": {
      "dynamic": true,
      "rule": "COUNT of pipeline rows where next_followup is not null AND next_followup <= today AND stage is an open stage (not Won/Lost)",
      "value_at_reference_date": 2
    },
    "open_pipeline_count": {"dynamic": false, "rule": "COUNT of pipeline rows with open stage", "value": 8},
    "open_pipeline_total_aed": {"dynamic": false, "rule": "SUM value of open-stage pipeline rows", "value": 257000},
    "open_pipeline_weighted_aed": {"dynamic": false, "rule": "SUM (value * stage probability) over open-stage rows: 18500*0.4 + 95000*0.6 + 7800*0.1 + 24000*0.25 + 6500*0.1 + 5200*0.4 + 32000*0.6 + 68000*0.25", "value": 110110},
    "new_leads_this_month": {
      "dynamic": true,
      "rule": "COUNT of pipeline rows where date_in is in the same calendar month+year as today",
      "value_at_reference_date": 2
    },
    "jobs_won_this_month_count": {
      "dynamic": true,
      "rule": "COUNT of jobs rows where start is in the same calendar month+year as today",
      "value_at_reference_date": 1
    },
    "jobs_won_this_month_aed": {
      "dynamic": true,
      "rule": "SUM of jobs.value where start is in the same calendar month+year as today",
      "value_at_reference_date": 5800
    },
    "win_rate": {"dynamic": false, "rule": "pipeline Won count / (Won + Lost count), all-time; 0 shown if no closed leads (divide-by-zero guard)", "value": 0.5},
    "invoiced_this_month_aed": {
      "dynamic": true,
      "rule": "SUM of invoices.amount where inv_date is in the same calendar month+year as today",
      "value_at_reference_date": 37900
    },
    "collected_this_month_aed": {
      "dynamic": true,
      "rule": "SUM of invoices.paid where paid_date is not null and in the same calendar month+year as today",
      "value_at_reference_date": 1500
    },
    "total_outstanding_aed": {"dynamic": false, "rule": "SUM of (amount - paid) over all invoices: 35000 + 10500 + 1400 + 35000", "value": 81900},
    "overdue_aed": {
      "dynamic": true,
      "rule": "SUM of (amount - paid) over invoices where balance > 0 AND due < today",
      "value_at_reference_date": 45500
    },
    "per_line_open_pipeline_aed": {
      "dynamic": false,
      "rule": "SUMIFS of open-stage pipeline value by business line",
